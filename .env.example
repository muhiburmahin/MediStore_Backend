# Server
NODE_ENV=development
PORT=5000
# PostgreSQL (required). Use postgresql:// or postgres://
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/medistore"

# URLs (no trailing slash on FRONTEND_URL / BACKEND_URL recommended)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
PROD_APP_URL=

# Better Auth (base path must match Express mount: /api/auth)
BETTER_AUTH_SECRET=generate_a_long_random_string
BETTER_AUTH_URL=http://localhost:5000/api/auth

# Optional: JWT cookies for legacy clients (Better Auth session cookies are primary)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Gmail SMTP example; optional — password reset / verification emails skip if unset)
APP_USER=
APP_PASS=

# Google OAuth (optional — omit to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (optional — STRIPE checkout disabled if STRIPE_SECRET_KEY unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Bootstrap demo users (prisma db seed / npm run seed). Change in production.
ADMIN_SEED_EMAIL=developermdmahin@gmail.com
ADMIN_SEED_PASSWORD=pass1234a
ADMIN_SEED_NAME=Md Mahin

DEMO_SELLER_EMAIL=demo.seller@medistore.com
DEMO_SELLER_PASSWORD=pass1234a
DEMO_SELLER_NAME=Demo Seller

DEMO_CUSTOMER_EMAIL=demo.customer@medistore.com
DEMO_CUSTOMER_PASSWORD=pass1234a
DEMO_CUSTOMER_NAME=Demo Customer
